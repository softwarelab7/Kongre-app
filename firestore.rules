rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE AUTENTICACIÓN Y ROLES TEOCRÁTICOS (RBAC)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'hectorguti95@gmail.com' ||
        request.auth.token.email.lower() == 'hectorguti95@outlook.com'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOfCongregation(congId) {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            getUserData().congregationId == congId ||
            getUserData().congregationNumber == congId
          )
        )
      );
    }

    function isCoordinatorOf(congId) {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (
          exists(/databases/$(database)/documents/congregations/$(congId)) &&
          (
            get(/databases/$(database)/documents/congregations/$(congId)).data.settings.coordinatorEmail == request.auth.token.email ||
            get(/databases/$(database)/documents/congregations/$(congId)).data.coordinatorEmail == request.auth.token.email
          )
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().theocraticRole == 'coordinador' &&
          (getUserData().congregationId == congId || getUserData().congregationNumber == congId)
        )
      );
    }

    function hasTheocraticRole(congId, requiredRoles) {
      return isAuthenticated() && (
        isMasterAdmin() ||
        isCoordinatorOf(congId) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().theocraticRole in requiredRoles &&
          (getUserData().congregationId == congId || getUserData().congregationNumber == congId)
        )
      );
    }

    // =========================================================================
    // 1. REGLAS PARA PERFILES DE USUARIO (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || isMasterAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().congregationId == resource.data.congregationId
      );
      allow create, update: if isUser(userId) || isMasterAdmin();
      allow delete: if isUser(userId) || isMasterAdmin();

      match /{document=**} {
        allow read, write: if isUser(userId) || isMasterAdmin();
      }
    }

    // =========================================================================
    // 2. REGLAS PARA CONGREGACIONES (/congregations/{congregationId})
    // =========================================================================
    match /congregations/{congregationId} {
      // Lectura: Miembros autenticados de la congregación o descubrimiento inicial
      allow read: if isAuthenticated() || resource == null;

      // Creación: Cualquier usuario registrado puede crear/inscribir una nueva congregación
      allow create: if isAuthenticated();

      // Actualización: Restringida a Coordinador oficial o Admin Maestro; otros miembros no pueden alterar el email del coordinador
      allow update: if isAuthenticated() && (
        isMasterAdmin() ||
        isCoordinatorOf(congregationId) ||
        (resource.data.settings.coordinatorEmail != null && resource.data.settings.coordinatorEmail == request.auth.token.email) ||
        (
          isMemberOfCongregation(congregationId) &&
          (
            // No se permite modificar o secuestrar el email del coordinador existente
            resource.data.settings.coordinatorEmail == request.resource.data.settings.coordinatorEmail
          )
        )
      );

      // Eliminación: Estrictamente reservada al Coordinador oficial o Admin Maestro
      allow delete: if isMasterAdmin() || isCoordinatorOf(congregationId);

      // =======================================================================
      // 3. SUBCOLECCIONES DEPARTAMENTALES POR ROLES TEOCRÁTICOS (RBAC)
      // =======================================================================

      // Publicadores y Tarjetas S-21 (Coordinador, Secretario y Ancianos)
      match /publishers/{pubId} {
        allow read: if isMemberOfCongregation(congregationId);
        allow write: if hasTheocraticRole(congregationId, ['coordinador', 'secretario', 'superintendente_vym', 'anciano']);
      }

      // Programación Semanal Vida y Ministerio (Superintendente VyM, Ancianos y Coordinador)
      match /weeks/{weekId} {
        allow read: if isMemberOfCongregation(congregationId);
        allow write: if hasTheocraticRole(congregationId, ['coordinador', 'superintendente_vym', 'anciano']);
      }

      // Territorios y Carritos (Siervo de Territorios y Coordinador)
      match /territories/{terrId} {
        allow read: if isMemberOfCongregation(congregationId);
        allow write: if hasTheocraticRole(congregationId, ['coordinador', 'siervo_territorios']);
      }

      // Cuentas y Auditorías (Siervo de Cuentas y Coordinador)
      match /accounts/{accId} {
        allow read, write: if hasTheocraticRole(congregationId, ['coordinador', 'siervo_cuentas']);
      }

      // Literatura e Inventario (Siervo de Literatura y Coordinador)
      match /literature/{litId} {
        allow read: if isMemberOfCongregation(congregationId);
        allow write: if hasTheocraticRole(congregationId, ['coordinador', 'siervo_literatura']);
      }

      // Tablero de Anuncios (Lectura todos, redacción Ancianos)
      match /notices/{noticeId} {
        allow read: if isMemberOfCongregation(congregationId);
        allow write: if hasTheocraticRole(congregationId, ['coordinador', 'secretario', 'superintendente_vym', 'anciano']);
      }

      // Fallback para subcolecciones adicionales
      match /{subcollection}/{docId} {
        allow read: if isMemberOfCongregation(congregationId) || isAuthenticated();
        allow write: if isCoordinatorOf(congregationId) || isMemberOfCongregation(congregationId);
      }
    }
  }
}
