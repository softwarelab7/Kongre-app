{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kongre",
  "version": "0.1.0-alpha.39",
  "identifier": "org.kongre.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kongre App - Gestor Teocrático",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libsoup3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQkEwMDE1RDUzMDA0NzcKUldSM0JERFZGUUM2cStoWUVtOWRIbUMyZmlwNGF3N0dxNU0vRXh3T3hFL3FQOGxzNFBQZnE3ZkQK",
      "endpoints": [
        "https://github.com/softwarelab7/Kongre-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

